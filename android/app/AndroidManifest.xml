<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="org.yeonggeoljeon.engine.android">
    <uses-sdk android:minSdkVersion="28" android:targetSdkVersion="35"/>
    <application android:label="영걸전" android:icon="@mipmap/ic_launcher" android:extractNativeLibs="true"
        android:allowBackup="false" android:theme="@android:style/Theme.Material.NoActionBar">
        <activity android:name=".MainActivity" android:exported="true" android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout"
            android:screenOrientation="unspecified" android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
